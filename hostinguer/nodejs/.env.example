PORT=3000
NODE_ENV=production

DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_password
DB_NAME=your_database

# Optional for PostgreSQL/Supabase deployments. Leave empty when using DB_* above.
DATABASE_URL=

API_URL=https://www.trespescadoresstore.com.br
FRONTEND_URL=https://www.trespescadoresstore.com.br,https://trespescadoresstore.com.br
CORS_ORIGINS=https://www.trespescadoresstore.com.br,https://trespescadoresstore.com.br

JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
LOG_LEVEL=info
