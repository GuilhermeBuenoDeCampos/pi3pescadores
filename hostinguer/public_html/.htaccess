PassengerAppRoot /home/u355040490/domains/trespescadoresstore.com.br/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /
PassengerRestartDir /home/u355040490/domains/trespescadoresstore.com.br/nodejs/tmp

SetEnv NODE_OPTIONS "--require /home/u355040490/domains/trespescadoresstore.com.br/public_html/.builds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.builds(?:/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
