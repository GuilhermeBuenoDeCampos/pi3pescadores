PORT=3000
NODE_ENV=development

DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_password
DB_NAME=postgres

DATABASE_URL=postgresql://<user>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

API_URL=http://localhost:3000
# Aceita uma ou mais origens separadas por vírgula.
# Desenvolvimento local + Cloudflare Pages em produção:
FRONTEND_URL=http://localhost:5173,http://localhost:5174,https://pi3pescadores.pages.dev

JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
LOG_LEVEL=info
